      "slot": "am",
      "publishAt": "2026-08-28T00:00:00.000Z",
      "text": "It doesn't need to be big. It just needs to be yours.",
      "source": "fallback"
    },
    {
      "id": "2026-08-29-am",
      "date": "2026-08-29",
      "slot": "am",
      "publishAt": "2026-08-29T00:00:00.000Z",
      "text": "It doesn't need to be big. It just needs to be yours.",
      "source": "fallback"
    },
    {
      "id": "2026-08-30-am",
      "date": "2026-08-30",
      "slot": "am",
      "publishAt": "2026-08-30T00:00:00.000Z",
      "text": "It doesn't need to be big. It just needs to be yours.",
      "source": "fallback"
    },
    {
      "id": "2026-08-31-am",
      "date": "2026-08-31",
      "slot": "am",
      "publishAt": "2026-08-31T00:00:00.000Z",
      "text": "Small steps still count as walking.",
      "source": "fallback"
    },
    {
      "id": "2026-09-01-am",
      "date": "2026-09-01",
      "slot": "am",
      "publishAt": "2026-09-01T00:00:00.000Z",
      "text": "Be a little kinder to yourself than you think you deserve. It usually balances out.",
      "source": "fallback"
    },
    {
      "id": "2026-09-02-am",
      "date": "2026-09-02",
      "slot": "am",
      "publishAt": "2026-09-02T00:00:00.000Z",
      "text": "You don't have to do it all — just the next small thing.",
      "source": "fallback"
    },
    {
      "id": "2026-09-03-am",
      "date": "2026-09-03",
      "slot": "am",
      "publishAt": "2026-09-03T00:00:00.000Z",
      "text": "Whatever's half-finished is allowed to stay half-finished. Pick it up when you're ready.",
      "source": "fallback"
    },
    {
      "id": "2026-09-04-am",
      "date": "2026-09-04",
      "slot": "am",
      "publishAt": "2026-09-04T00:00:00.000Z",
      "text": "Nothing has to be figured out all at once. You're allowed to just be here for a minute.",
      "source": "fallback"
    },
    {
      "id": "2026-09-05-am",
      "date": "2026-09-05",
      "slot": "am",
      "publishAt": "2026-09-05T00:00:00.000Z",
      "text": "Drink some water, unclench your jaw, and go be a person.",
      "source": "fallback"
    },
    {
      "id": "2026-09-06-am",
      "date": "2026-09-06",
      "slot": "am",
      "publishAt": "2026-09-06T00:00:00.000Z",
      "text": "You're allowed to start before you feel ready.",
      "source": "fallback"
    },
    {
      "id": "2026-09-07-am",
      "date": "2026-09-07",
      "slot": "am",
      "publishAt": "2026-09-07T00:00:00.000Z",
      "text": "Low stakes. Take it gentle.",
      "source": "fallback"
    },
    {
      "id": "2026-09-08-am",
      "date": "2026-09-08",
      "slot": "am",
      "publishAt": "2026-09-08T00:00:00.000Z",
      "text": "You're trying, and that quietly counts more than it feels like it does.",
      "source": "fallback"
    },
    {
      "id": "2026-09-09-am",
      "date": "2026-09-09",
      "slot": "am",
      "publishAt": "2026-09-09T00:00:00.000Z",
      "text": "It doesn't need to be big. It just needs to be yours.",
      "source": "fallback"
    }
  ]
