{
  "updated": "2026-08-29T02:50:27.403Z",
  "entries": [
    {
      "id": "2026-08-16-am",
      "date": "2026-08-16",
      "slot": "am",
      "publishAt": "2026-08-16T00:00:00.000Z",
      "text": "Small steps still count as walking.",
      "source": "fallback"
    },
    {
      "id": "2026-08-17-am",
      "date": "2026-08-17",
      "slot": "am",
      "publishAt": "2026-08-17T00:00:00.000Z",
      "text": "Be a little kinder to yourself than you think you deserve. It usually balances out.",
      "source": "fallback"
    },
    {
      "id": "2026-08-18-am",
      "date": "2026-08-18",
      "slot": "am",
      "publishAt": "2026-08-18T00:00:00.000Z",
      "text": "You don't have to do it all — just the next small thing.",
      "source": "fallback"
    },
    {
      "id": "2026-08-19-am",
      "date": "2026-08-19",
      "slot": "am",
      "publishAt": "2026-08-19T00:00:00.000Z",
      "text": "Whatever's half-finished is allowed to stay half-finished. Pick it up when you're ready.",
      "source": "fallback"
    },
    {
      "id": "2026-08-20-am",
      "date": "2026-08-20",
      "slot": "am",
      "publishAt": "2026-08-20T00:00:00.000Z",
      "text": "Nothing has to be figured out all at once. You're allowed to just be here for a minute.",
      "source": "fallback"
    },
    {
      "id": "2026-08-21-am",
      "date": "2026-08-21",
      "slot": "am",
      "publishAt": "2026-08-21T00:00:00.000Z",
      "text": "Drink some water, unclench your jaw, and go be a person.",
      "source": "fallback"
    },
    {
      "id": "2026-08-22-am",
      "date": "2026-08-22",
      "slot": "am",
      "publishAt": "2026-08-22T00:00:00.000Z",
      "text": "You're allowed to start before you feel ready.",
      "source": "fallback"
    },
    {
      "id": "2026-08-23-am",
      "date": "2026-08-23",
      "slot": "am",
      "publishAt": "2026-08-23T00:00:00.000Z",
      "text": "Low stakes. Take it gentle.",
      "source": "fallback"
    },
    {
      "id": "2026-08-24-am",
      "date": "2026-08-24",
      "slot": "am",
      "publishAt": "2026-08-24T00:00:00.000Z",
      "text": "You're trying, and that quietly counts more than it feels like it does.",
      "source": "fallback"
    },
    {
      "id": "2026-08-25-am",
      "date": "2026-08-25",
      "slot": "am",
      "publishAt": "2026-08-25T00:00:00.000Z",
      "text": "It doesn't need to be big. It just needs to be yours.",
      "source": "fallback"
    },
    {
      "id": "2026-08-26-am",
      "date": "2026-08-26",
      "slot": "am",
      "publishAt": "2026-08-26T00:00:00.000Z",
      "text": "It doesn't need to be big. It just needs to be yours.",
      "source": "fallback"
    },
